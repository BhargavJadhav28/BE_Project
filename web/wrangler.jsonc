{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "helios-microgrid-web",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2024-09-23",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	}
}
